! V03: diffuse-gray radiation between two coaxial disks (axisymmetric, Gebhart factors).
! Lower disk held at 1200 K on its bottom face; upper disk floats, insulated on its top and
! rim, so it settles where absorbed and emitted radiation balance on its lower face. The gap
! is open to black surroundings at 300 K. High conductivity keeps each disk isothermal.
! Emissivities are set by the $eps1 / $eps2 parameters below (edited by the test driver).
! References: black surfaces, exact T2^4 = F12 T1^4 + (1 - F12) Text^4 with the coaxial
! disk view factor; gray surfaces, an independent ring radiosity solution
! (mbe_twin.radiation).
$eps1 = 0.8
$eps2 = 0.3

Header
  Mesh DB "." "mesh"
End

Simulation
  Coordinate System = Axi Symmetric
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
End

Constants
  Stefan Boltzmann = 5.670374419e-08
End

Body 1
  Equation = 1
  Material = 1
End

Body 2
  Equation = 1
  Material = 1
End

Body 3
  Name = "gap (no equation)"
  Material = 1
End

Material 1
  Heat Conductivity = 1.0e4
  Density = 1.0
End

Equation 1
  Active Solvers(1) = 1
End

Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 200
  Nonlinear System Convergence Tolerance = 1.0e-10
  Nonlinear System Newton After Iterations = 5
  Nonlinear System Newton After Tolerance = 1.0e-4
  Steady State Convergence Tolerance = 1.0e-10
  Update View Factors = True
End

Solver 2
  Exec Solver = After Simulation
  Equation = SaveLine
  Procedure = "SaveData" "SaveLine"
  Filename = "line.dat"
  Polyline Coordinates(2,2) = 0.0 0.023 0.05 0.023
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Temperature = 1200.0
End

Boundary Condition 2
  Target Boundaries(1) = 5
  Radiation Target Body = 3
  Radiation = Diffuse Gray
  Radiation Boundary Open = True
  External Temperature = 300.0
  Emissivity = $eps1
End

Boundary Condition 3
  Target Boundaries(1) = 6
  Radiation Target Body = 3
  Radiation = Diffuse Gray
  Radiation Boundary Open = True
  External Temperature = 300.0
  Emissivity = $eps2
End
